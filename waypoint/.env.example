# Waypoint environment example.
#
# Copy to .env (backend) and fill in only if you want the optional extras.
# The product is fully functional with every variable unset.
#
# NEVER commit a real key. If WAYPOINT_AI_API_KEY is unset, Waypoint uses its
# deterministic, grounded planner and nothing calls an external model.

# --- Optional: where the supplied read-only PackagePro data lives ---
# Defaults to <repo>/PackagePro/data/PS-04.db. Override only if you relocated it.
# WAYPOINT_PACKAGEPRO_DB=/absolute/path/to/PackagePro/data/PS-04.db

# --- Optional: where Waypoint keeps its own session/cart/audit state ---
# This is a SEPARATE database from PS-04.db, which is never written to.
# WAYPOINT_SESSION_DB=/absolute/path/to/waypoint_sessions.db

# --- MVP currency. INR only; conversion is out of scope ---
WAYPOINT_CURRENCY=INR

# --- Optional: AI/model integration (not required for the MVP) ---
# Leave unset to run fully offline with the deterministic planner.
# WAYPOINT_AI_API_KEY=
# WAYPOINT_AI_BASE_URL=
# WAYPOINT_AI_MODEL=

# --- Optional: server bind ---
WAYPOINT_HOST=127.0.0.1
WAYPOINT_PORT=8000
