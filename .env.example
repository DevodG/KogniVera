# =============================================================================
# Waypoint — Agentic Travel Concierge
# Copy this file to `.env` in the repo root and fill in what you have.
# Nothing here is required to run the app — every integration has a mock
# fallback (see backend/app/agent/tools.py) so you can demo with zero keys
# and layer in real data incrementally.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — REQUIRED for real agent reasoning (mock fallback works without it)
# -----------------------------------------------------------------------------
# Get a free key: https://build.nvidia.com -> sign in -> Settings -> API Keys
# No credit card. ~1,000 free credits, 40 req/min. Key looks like: nvapi-xxxxx
NVIDIA_API_KEY=

# NVIDIA NIM is OpenAI-compatible — this base URL should not need to change.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Any model id from https://build.nvidia.com/models works here. Recommended:
#   zai-org/glm-5.2            — best free NIM model for agent/tool-calling loops, 1M ctx
#   nvidia/nemotron-3-ultra    — NVIDIA's own, strong on BFCL/tau-bench function-calling
AGENT_MODEL=zai-org/glm-5.2
FAST_MODEL=nvidia/nemotron-3-ultra

# Set to "openai" or "anthropic" to bypass NIM entirely (see app/agent/llm_client.py)
LLM_PROVIDER=nvidia_nim
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Flights — OPTIONAL (mock data used until set)
# -----------------------------------------------------------------------------
# Amadeus for Developers — free self-service tier, sandbox test data.
# Sign up: https://developers.amadeus.com/register
# Create an app -> get Client ID / Secret from the app's dashboard.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# Alternative flight source (not yet wired, listed for future use):
# Skyscanner via RapidAPI — https://rapidapi.com/skyscanner/api/skyscanner-flight-search
SKYSCANNER_API_KEY=REDACTED_ROTATE

# -----------------------------------------------------------------------------
# Hotels — OPTIONAL (mock data used until set)
# -----------------------------------------------------------------------------
# Hotelbeds APItude — free sandbox for developers.
# Sign up: https://developer.hotelbeds.com/signup
# Auth uses a signed request (SHA256 of key+secret+timestamp) — see
# app/agent/tools.py::_search_hotels_hotelbeds for where to implement it.
HOTELBEDS_API_KEY=REDACTED_ROTATE
HOTELBEDS_API_SECRET=REDACTED_ROTATE

# -----------------------------------------------------------------------------
# Places / nearby attractions — OPTIONAL (mock data used until set)
# -----------------------------------------------------------------------------
# Google Places API — https://console.cloud.google.com -> enable "Places API"
# Free tier: $200/month credit, which covers a hackathon/demo comfortably.
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# Currency conversion — OPTIONAL (used by a future multi-currency feature)
# -----------------------------------------------------------------------------
# ExchangeRate-API — free tier, 1,500 req/month.
# Sign up: https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=

# -----------------------------------------------------------------------------
# Notifications — OPTIONAL (for the future "proactive rebooking" agent)
# -----------------------------------------------------------------------------
# Twilio (SMS for SOS-style alerts / proactive rebooking pings)
# Sign up: https://console.twilio.com — free trial credit available.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend (transactional email for plan summaries / alerts)
# Sign up: https://resend.com — generous free tier, no card required.
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Budget guardrail
# -----------------------------------------------------------------------------
DEFAULT_SESSION_SPEND_CAP_USD=25000
AGENT_BUDGET_HARD_STOP=true

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# Default: local SQLite file, zero setup.
DATABASE_URL=sqlite+aiosqlite:///./concierge.db
# Swap for Postgres in production, e.g. a free tier on https://neon.tech or https://supabase.com:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# =============================================================================
# FUTURE / NOT YET WIRED — keep these names reserved so the team doesn't
# collide on env var naming as features get added over the month:
# =============================================================================
# STRIPE_SECRET_KEY=            # real payment behind the confirm-booking endpoint
# RAZORPAY_KEY_ID=              # India-first payment alternative to Stripe
# RAZORPAY_KEY_SECRET=
# SENTRY_DSN=                   # error tracking once this leaves demo stage
# POSTHOG_API_KEY=              # product analytics
# MAPBOX_API_KEY=               # map view for the itinerary (SmartTrip-style features)
