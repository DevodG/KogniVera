# ──────────────────────────────────────────────────────
# Waypoint — environment variables
# ──────────────────────────────────────────────────────
# Copy to .env and fill in only what you need.
# The app is fully functional with everything unset.
# NEVER commit a real key.

# --- PackagePro data (read-only) ---
# Defaults to <repo>/PackagePro/data/PS-04.db
# WAYPOINT_PACKAGEPRO_DB=/absolute/path/to/PackagePro/data/PS-04.db

# --- Waypoint session store (separate from canonical DB) ---
# WAYPOINT_SESSION_DB=/absolute/path/to/waypoint_sessions.db

# --- Currency (INR only, enforced in code) ---
WAYPOINT_CURRENCY=INR

# --- Optional: NVIDIA NIM AI integration ---
# Leave unset for fully offline deterministic planner.
# WAYPOINT_AI_API_KEY=
# WAYPOINT_AI_BASE_URL=https://integrate.api.nvidia.com/v1
# WAYPOINT_AI_MODEL=meta/llama-3.1-70b-instruct

# --- Optional: External API adapters (mock by default) ---
# AMADEUS_API_KEY=
# AMADEUS_API_SECRET=
# HOTELBEDS_API_KEY=
# HOTELBEDS_SECRET=
# GOOGLE_PLACES_API_KEY=

# --- Server bind ---
WAYPOINT_HOST=127.0.0.1
WAYPOINT_PORT=8000
