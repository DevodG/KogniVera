# =============================================================================
# PackagePro — Dynamic Tour Packages (PS-04)
#
# The app runs with ZERO environment variables. Every value below is optional.
# The intelligence is a deterministic scoring engine over the real PS-04.db
# rows; there is no LLM key to obtain and no external travel API to register.
# =============================================================================

# -----------------------------------------------------------------------------
# Data — OPTIONAL
# -----------------------------------------------------------------------------
# The PackagePro dataset is bundled at PackagePro/data/PS-04.db and is found
# automatically. Override only if you relocate or copy the dataset.
# PACKAGEPRO_DB_PATH=/absolute/path/to/PS-04.db

# -----------------------------------------------------------------------------
# Server — OPTIONAL
# -----------------------------------------------------------------------------
# Backend serves on 127.0.0.1:8100 (the Vite dev proxy targets this port).
# PORT=8100

# =============================================================================
# Reserved for post-hackathon work — not read by any code today.
# =============================================================================
# STRIPE_SECRET_KEY=            # real payment behind a confirm step
# RAZORPAY_KEY_ID=              # India-first payment alternative
# RAZORPAY_KEY_SECRET=
# LLM_API_KEY=                  # optional LLM layer over the deterministic engine
# SENTRY_DSN=                   # error tracking once this leaves demo stage
